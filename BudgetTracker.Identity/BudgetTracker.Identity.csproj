<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
      <UserSecretsId>c5864a76-44bb-4546-87cf-4e4fc6f66512</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MailKit" Version="4.18.0" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
      <PackageReference Include="OpenIddict" Version="8.0.0-preview.4.26456.66" />
      <PackageReference Include="OpenIddict.AspNetCore" Version="8.0.0-preview.4.26456.66" />
      <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="8.0.0-preview.4.26456.66" />
      <PackageReference Include="QRCoder" Version="1.6.0" />
    </ItemGroup>

    <ItemGroup>
      <!-- Szablony maili wbudowane w assembly, żeby renderer nie zależał od katalogu roboczego ani od publikacji plików. -->
      <EmbeddedResource Include="Emails\*.html;Emails\*.css" LogicalName="Emails.%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
