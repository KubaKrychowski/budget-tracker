@{
    ViewData["Title"] = "Sprawdź skrzynkę";
}

<div class="auth-header">
    <h1>Sprawdź skrzynkę e-mail</h1>
    <p>Jeśli podany adres jest zarejestrowany i jeszcze niepotwierdzony, wysłaliśmy na niego link potwierdzający konto.</p>
</div>

@if (TempData["DevConfirmLink"] is string { Length: > 0 } link)
{
    <div class="auth-dev-note">
        <strong>Tryb deweloperski</strong> — link potwierdzający pokazujemy tutaj (poza tym trafia normalnie
        do MailHoga pod <a href="http://localhost:8025" class="auth-link">localhost:8025</a>):<br/>
        <a href="@link" class="auth-link">@link</a>
    </div>
}

<div class="auth-actions">
    <a asp-action="Login" class="auth-link">Wróć do logowania</a>
</div>
