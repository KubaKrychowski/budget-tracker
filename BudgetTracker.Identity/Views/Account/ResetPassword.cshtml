@model ResetPasswordViewModel
@{
    ViewData["Title"] = L["ResetPassword_Title"];
}

<div class="auth-header">
    <h1>@L["ResetPassword_Title"]</h1>
    <p>@L["Password_Hint", PasswordPolicy.MinLength]</p>
</div>

<form asp-action="ResetPassword" method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly"></div>
    <input asp-for="Email" type="hidden"/>
    <input asp-for="Token" type="hidden"/>

    <div class="auth-field">
        <label asp-for="Password">@L["Field_NewPassword"]</label>
        <input asp-for="Password" placeholder="@L["Placeholder_PasswordMin", PasswordPolicy.MinLength]" autocomplete="new-password" autofocus/>
        <span asp-validation-for="Password"></span>
    </div>

    <div class="auth-field">
        <label asp-for="ConfirmPassword">@L["Field_ConfirmNewPassword"]</label>
        <input asp-for="ConfirmPassword" placeholder="@L["Placeholder_RepeatPassword"]" autocomplete="new-password"/>
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit" class="btn-primary">@L["ResetPassword_Submit"]</button>
</form>
