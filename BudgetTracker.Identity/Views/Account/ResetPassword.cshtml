@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Ustaw nowe hasło";
}

<div class="auth-header">
    <h1>Ustaw nowe hasło</h1>
    <p>Min. 8 znaków, w tym wielka litera, cyfra i znak specjalny</p>
</div>

<form asp-action="ResetPassword" method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly"></div>
    <input asp-for="Email" type="hidden"/>
    <input asp-for="Token" type="hidden"/>

    <div class="auth-field">
        <label asp-for="Password">Nowe hasło</label>
        <input asp-for="Password" placeholder="min. 8 znaków" autocomplete="new-password" autofocus/>
        <span asp-validation-for="Password"></span>
    </div>

    <div class="auth-field">
        <label asp-for="ConfirmPassword">Powtórz nowe hasło</label>
        <input asp-for="ConfirmPassword" placeholder="powtórz hasło" autocomplete="new-password"/>
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit" class="btn-primary">Zapisz nowe hasło</button>
</form>
