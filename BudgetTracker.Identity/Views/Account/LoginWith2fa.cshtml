@model LoginWith2faViewModel
@{
    ViewData["Title"] = "Weryfikacja dwuetapowa";
}

<div class="auth-header">
    <h1>Weryfikacja dwuetapowa</h1>
    <p>Wpisz 6-cyfrowy kod z aplikacji uwierzytelniającej</p>
</div>

<form asp-action="LoginWith2fa" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe" method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly"></div>
    <input asp-for="ReturnUrl" type="hidden"/>

    <div class="auth-field">
        <label asp-for="TwoFactorCode">Kod weryfikacyjny</label>
        <input asp-for="TwoFactorCode" placeholder="123 456" autocomplete="one-time-code" inputmode="numeric" autofocus/>
        <span asp-validation-for="TwoFactorCode"></span>
    </div>

    <div class="auth-checkbox">
        <input asp-for="RememberMachine" type="checkbox"/>
        <label asp-for="RememberMachine">Zapamiętaj to urządzenie</label>
    </div>

    <div class="auth-actions">
        <button type="submit" class="btn-primary">Zweryfikuj</button>
        <a asp-action="LoginWith2faEmail" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe" class="auth-link">Wyślij kod na e-mail zamiast</a>
        <a asp-action="LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">Użyj kodu zapasowego</a>
    </div>
</form>
