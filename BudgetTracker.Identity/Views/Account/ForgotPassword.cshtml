@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Nie pamiętasz hasła?";
}

<div class="auth-header">
    <h1>Nie pamiętasz hasła?</h1>
    <p>Podaj adres e-mail, a wyślemy link do zresetowania hasła</p>
</div>

<form asp-action="ForgotPassword" method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="auth-field">
        <label asp-for="Email">Adres e-mail</label>
        <input asp-for="Email" placeholder="np. jan.kowalski@poczta.pl" autocomplete="username" autofocus/>
        <span asp-validation-for="Email"></span>
    </div>

    <div class="auth-actions">
        <button type="submit" class="btn-primary">Wyślij link resetujący</button>
        <a asp-action="Login" class="auth-link">Wróć do logowania</a>
    </div>
</form>
