@{
    ViewData["Title"] = "Sprawdź skrzynkę";
}

<div class="auth-header">
    <h1>Sprawdź skrzynkę e-mail</h1>
    <p>Jeśli podany adres jest zarejestrowany, wysłaliśmy na niego link do zresetowania hasła.</p>
</div>

@if (TempData["DevResetLink"] is string { Length: > 0 } link)
{
    <div class="auth-dev-note">
        <strong>Tryb deweloperski</strong> — w projekcie nie ma jeszcze podpiętej wysyłki e-mail,
        więc link resetujący pokazujemy tutaj zamiast go wysyłać:<br/>
        <a href="@link" class="auth-link">@link</a>
    </div>
}

<div class="auth-actions">
    <a asp-action="Login" class="auth-link">Wróć do logowania</a>
</div>
