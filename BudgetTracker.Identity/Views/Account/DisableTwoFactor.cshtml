@model ReturnUrlViewModel
@{
    ViewData["Title"] = "Wyłącz weryfikację dwuetapową";
}

<div class="auth-header">
    <h1>Wyłączyć weryfikację dwuetapową?</h1>
    <p>Logowanie będzie odtąd wymagało tylko hasła. Będziesz mógł/mogła włączyć 2FA ponownie w dowolnym momencie.</p>
</div>

<form asp-action="DisableTwoFactor" method="post" class="auth-actions">
    @Html.AntiForgeryToken()
    <input asp-for="ReturnUrl" type="hidden"/>
    <button type="submit" class="btn-primary">Wyłącz 2FA</button>
    @if (!string.IsNullOrEmpty(Model.ReturnUrl))
    {
        <a href="@Model.ReturnUrl" class="auth-link">Anuluj</a>
    }
</form>
