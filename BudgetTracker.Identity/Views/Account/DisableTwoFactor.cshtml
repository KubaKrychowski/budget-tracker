@model ReturnUrlViewModel
@{
    ViewData["Title"] = L["DisableTwoFactor_Title"];
}

<div class="auth-header">
    <h1>@L["DisableTwoFactor_Heading"]</h1>
    <p>@L["DisableTwoFactor_Text"]</p>
</div>

<form asp-action="DisableTwoFactor" method="post" class="auth-actions">
    @Html.AntiForgeryToken()
    <input asp-for="ReturnUrl" type="hidden"/>
    <button type="submit" class="btn-primary">@L["DisableTwoFactor_Submit"]</button>
    @if (!string.IsNullOrEmpty(Model.ReturnUrl))
    {
        <a href="@Model.ReturnUrl" class="auth-link">@L["Common_Cancel"]</a>
    }
</form>
