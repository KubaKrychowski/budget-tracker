@model LoginViewModel
@{
    ViewData["Title"] = "Logowanie";
}

<div class="auth-header">
    <h1>Budżet tracker</h1>
    <p>Zaloguj się, aby zarządzać swoim budżetem</p>
</div>

<form asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="auth-field">
        <label asp-for="Email">Adres e-mail</label>
        <input asp-for="Email" placeholder="np. jan.kowalski@poczta.pl" autocomplete="username" autofocus/>
        <span asp-validation-for="Email"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Password">Hasło</label>
        <input asp-for="Password" placeholder="••••••••" autocomplete="current-password"/>
        <span asp-validation-for="Password"></span>
    </div>

    <div class="auth-row">
        <label class="auth-checkbox">
            <input asp-for="RememberMe" type="checkbox"/> Zapamiętaj mnie
        </label>
        <a asp-action="ForgotPassword" class="auth-link">Nie pamiętasz hasła?</a>
    </div>

    @if (ViewData["ShowResendConfirmation"] is true)
    {
        <div class="auth-row">
            <a asp-action="ResendEmailConfirmation" class="auth-link">Wyślij link potwierdzający ponownie</a>
        </div>
    }

    <div class="auth-actions">
        <button type="submit" class="btn-primary">Zaloguj się</button>
        <div class="auth-footer-row">
            <span>Nie masz konta?</span>
            <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">Załóż konto</a>
        </div>
    </div>
</form>
