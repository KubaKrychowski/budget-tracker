@model ResendEmailConfirmationViewModel
@{
    ViewData["Title"] = L["Resend_Title"];
}

<div class="auth-header">
    <h1>@L["Resend_Title"]</h1>
    <p>@L["Resend_Subtitle"]</p>
</div>

<form asp-action="ResendEmailConfirmation" method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="auth-field">
        <label asp-for="Email">@L["Field_Email"]</label>
        <input asp-for="Email" placeholder="@L["Placeholder_Email"]" autocomplete="username" autofocus/>
        <span asp-validation-for="Email"></span>
    </div>

    <div class="auth-actions">
        <button type="submit" class="btn-primary">@L["Resend_Submit"]</button>
        <a asp-action="Login" class="auth-link">@L["Common_BackToLogin"]</a>
    </div>
</form>
