@model AuthorizeViewModel
@{
    ViewData["Title"] = L["Authorize_Title"];
}

<div class="auth-header">
    <h1>@L["Authorize_Heading", Model.ApplicationName]</h1>
    <p>@L["Authorize_Text", Model.ApplicationName, Model.UserEmail]</p>
</div>

<div class="auth-scopes-box">
    <span class="scope-label">@L["Authorize_ScopesLabel"]</span>
    <ul>
        @foreach (var scope in Model.Scopes)
        {
            var label = L[$"Scope_{scope}"];
            <li>@(label.ResourceNotFound ? scope : label.Value)</li>
        }
    </ul>
</div>

<form action="~/connect/authorize" method="post" class="auth-consent-actions">
    @Html.AntiForgeryToken()
    @* OpenIddict czyta parametry POST-a WYŁĄCZNIE z ciała formularza (nie z query stringu) —
       przepisujemy więc oryginalne parametry żądania z GET jako pola ukryte. *@
    @foreach (var (key, values) in Context.Request.Query)
    {
        foreach (var value in values)
        {
            <input type="hidden" name="@key" value="@value"/>
        }
    }
    <button type="submit" name="submit.Deny" value="true" class="btn-secondary">@L["Authorize_Deny"]</button>
    <button type="submit" name="submit.Accept" value="true" class="btn-primary">@L["Authorize_Allow"]</button>
</form>
