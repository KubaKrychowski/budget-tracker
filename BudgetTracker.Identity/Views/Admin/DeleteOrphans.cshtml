@model DeleteOrphansViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Admin_DeleteOrphans_Title"];
}

<div class="auth-header">
    <h1>@L["Admin_DeleteOrphans_Title"]</h1>
</div>

<form asp-action="DeleteOrphans" asp-route-ownerId="@Model.OwnerId" method="post" class="auth-form">
    <div class="alert alert-danger" role="alert">
        <div class="alert-body">
            <span class="alert-title">@L["Admin_DeleteUser_AlertTitle"]</span>
            <span>@L["Admin_DeleteOrphans_AlertText", Model.OwnerId, L["Admin_Data_Detail", Model.Counts.Budgets, Model.Counts.Transactions, Model.Counts.SavingsGoals, Model.Counts.SavingsReservations, Model.Counts.StandingOrders, Model.Counts.EpisodicOrders].Value]</span>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly"></div>

    <div class="auth-field">
        <label asp-for="Confirmation">@L["Admin_DeleteOrphans_ConfirmLabel", Model.ExpectedConfirmation.Length]</label>
        <input asp-for="Confirmation" placeholder="@Model.ExpectedConfirmation" autocomplete="off" autofocus/>
        <span asp-validation-for="Confirmation"></span>
    </div>

    <div class="dialog-footer">
        <a asp-action="Orphans" class="btn-secondary">@L["Common_Cancel"]</a>
        <button type="submit" class="btn-danger">@L["Admin_DeleteUser_Submit"]</button>
    </div>
</form>
